[Unit]
Description=JSON Pretty · 只做JSON格式化
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=jsonpretty
Group=jsonpretty
WorkingDirectory=/opt/json-pretty

# ---------------------------- 环境变量 ----------------------------
Environment=NODE_ENV=production
Environment=PORT=3456
# 只监听回环地址，外部访问一律经 Nginx 转发，服务本身不暴露公网。
Environment=HOST=127.0.0.1
# 部署在 Nginx 后面：真实客户端 IP 在 X-Forwarded-For 里。
# 不开这个的话，限流会把所有访客当成同一个 IP（都是 127.0.0.1）。
Environment=TRUST_PROXY=1

# --------------------------- 敏感配置 -----------------------------
# 令牌这类敏感项请写到 /etc/json-pretty/env，**不要写在本文件里**：
# deploy.sh 每次安装都会用 deploy/json-pretty.service 重新生成这个单元，
# 直接改这里的内容会被覆盖掉（令牌一丢，抓取接口就变回人人可用的开放代理）。
#
#   sudo mkdir -p /etc/json-pretty
#   printf 'FETCH_TOKEN=%s\n' "$(openssl rand -hex 32)" | sudo tee /etc/json-pretty/env
#   sudo chmod 600 /etc/json-pretty/env
#   sudo systemctl daemon-reload && sudo systemctl restart json-pretty
#
# 行首的 - 表示该文件不存在也不报错。
EnvironmentFile=-/etc/json-pretty/env

# ---------------- ?url= 抓取接口的内网放行策略 ----------------
# 默认会拦截解析到内网 IP 的地址（防 SSRF）。需要抓取内网接口时，
# 解开其中一行改成自己的域名，然后：
#   systemctl daemon-reload && systemctl restart json-pretty
#
# 只放行指定域名（推荐，支持 *.example.com 通配）
# Environment=FETCH_ALLOW_HOSTS=api.rhino.datastory.com.cn,*.corp.example.com
#
# 放行全部内网地址（仅限内网自用，公网部署切勿开启）
# Environment=FETCH_ALLOW_PRIVATE=1

# ------------------------------ 启动 ------------------------------
# 若 node 不在 /usr/bin/node，用 `which node` 查到实际路径后修改
ExecStart=/usr/bin/node /opt/json-pretty/server.js

Restart=always
RestartSec=3

# ------------------------------ 日志 ------------------------------
StandardOutput=journal
StandardError=journal
SyslogIdentifier=json-pretty

# ---------------------------- 安全加固 ----------------------------
# 这一组选项会限制服务可访问的文件系统范围，属于纵深防御。
# 如果服务启动失败（用 systemctl status json-pretty 或 journalctl -u json-pretty 看报错），
# 可先整体注释掉下面这一段排查，确认能正常跑起来再逐条恢复。
NoNewPrivileges=true
PrivateTmp=true
# 整个文件系统只读。本服务不落盘任何数据，因此不需要 ReadWritePaths。
# 注意：若改了 WorkingDirectory，无需额外调整。
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
# 抓取远端链接需要对外发起 TCP 连接，故保留 INET / INET6。
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
